                <ANNOTATION_VALUE>я / Беляев Владислав Игоревич / эээ / не возражаю</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a882"
                TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>чтобы эта и другие сегодняшние записи моей речи были использованы / эээ / в учебных и научных целях</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>ну / на самом деле это сложный вопрос</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>потому что за свою жизнь /эээ/ я успел какое-то время / провести в нескольких регионах</ANNOTATION_VALUE>
